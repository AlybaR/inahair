# Copiez ce fichier en .env pour connecter le site à la boutique WooCommerce.
# Sans VITE_WOO_URL, le site fonctionne en mode démonstration (catalogue local, paiement simulé).

# Adresse de WordPress/WooCommerce, sans « / » final (même domaine recommandé : https://www.inahair.fr/wp)
VITE_WOO_URL=

# Chemin de l'espace client WooCommerce (« /mon-compte/ » sur un WordPress en français)
VITE_WOO_ACCOUNT_PATH=/mon-compte/
