# Hébergement Apache (OVH mutualisé) : toutes les routes du site renvoient vers index.html
Options -MultiViews
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Cache long pour les fichiers versionnés et les images, aucun cache pour index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
